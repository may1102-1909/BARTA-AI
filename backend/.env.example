# Server Configuration
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
PUBLIC_URL=https://your-public-tunnel.ngrok-free.app

# Gnani AI Credentials (Hard requirement for Great Indian AI Internship Challenge)
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_API_URL=https://api.vachana.ai/tts/v2/synthesize
GNANI_STT_LANG=hin-eng
GNANI_TTS_VOICE=timbre_hindi_female

# LLM Selection (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Email Service (Resend or SMTP)
RESEND_API_KEY=re_dummy_resend_key
EMAIL_FROM=orders@curatedindia.com
# Fallback SMTP (e.g. Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Database (SQLite by default for zero-setup local dev, or Supabase PostgreSQL URI)
DATABASE_URL=sqlite+aiosqlite:///./barta.db
SUPABASE_URL=
SUPABASE_KEY=

# Calling Window & Safety Defaults
DEFAULT_WINDOW_START=09:00
DEFAULT_WINDOW_END=20:00
DEFAULT_MAX_CONCURRENT=1

